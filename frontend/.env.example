# Vite development proxy target (not exposed in the browser bundle).
ITDA_API_TARGET=http://127.0.0.1:8000
# /api forwards /api/memos to ITDA_API_TARGET/memos in development.
# In production configure the same reverse proxy, or use an absolute API URL.
VITE_API_BASE_URL=/api
VITE_API_CREDENTIALS=same-origin
VITE_USE_MOCK=false
